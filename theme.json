{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1100px",
      "wideSize": "1140px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "duotone": [],
      "custom": true,
      "customGradient": false,
      "palette": [
        {
          "slug": "base",
          "name": "ベース（背景）",
          "color": "#ffffff"
        },
        {
          "slug": "base-2",
          "name": "ベース（薄グレー）",
          "color": "#f5f5f5"
        },
        {
          "slug": "contrast",
          "name": "コントラスト（本文）",
          "color": "#1a1a1a"
        },
        {
          "slug": "contrast-2",
          "name": "コントラスト（弱）",
          "color": "#5a5a5a"
        },
        {
          "slug": "accent",
          "name": "アクセント",
          "color": "#0073aa"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "system-font",
          "name": "システム（ゴシック）",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Helvetica Neue\", \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", Meiryo, sans-serif"
        },
        {
          "slug": "serif-font",
          "name": "明朝",
          "fontFamily": "\"Hiragino Mincho ProN\", \"Yu Mincho\", \"Noto Serif JP\", \"Times New Roman\", serif"
        },
        {
          "slug": "monospace-font",
          "name": "等幅",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Noto Sans Mono\", monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "小",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "標準",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "大",
          "size": "1.5rem",
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "name": "特大",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "ヒーロー",
          "size": "3rem",
          "fluid": {
            "min": "2rem",
            "max": "3rem"
          }
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "defaultSpacingSizes": false,
      "units": ["px", "em", "rem", "vw", "vh", "%"],
      "spacingSizes": [
        { "slug": "20", "name": "1 | XS", "size": "0.5rem" },
        { "slug": "30", "name": "2 | S", "size": "1rem" },
        { "slug": "40", "name": "3 | M", "size": "1.5rem" },
        { "slug": "50", "name": "4 | L", "size": "clamp(2rem, 4vw, 3rem)" },
        { "slug": "60", "name": "5 | XL", "size": "clamp(3rem, 6vw, 4.5rem)" },
        { "slug": "70", "name": "6 | 2XL", "size": "clamp(4rem, 8vw, 6rem)" },
        { "slug": "80", "name": "7 | 3XL", "size": "clamp(5rem, 10vw, 8rem)" }
      ]
    },
    "blocks": {
      "core/heading": {
        "color": {
          "custom": false
        }
      },
      "core/button": {
        "color": {
          "custom": false
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-font)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.8"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--40)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--40)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": {
          "radius": "4px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.75rem",
            "bottom": "0.75rem",
            "left": "1.75rem"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--contrast)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.4"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "1.25rem"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "1.125rem"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "1rem"
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--contrast-2)"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--contrast-2)",
            "style": "solid",
            "width": "3px"
          }
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--40)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "ヘッダー",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "フッター",
      "area": "footer"
    }
  ]
}
